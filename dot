#!/usr/bin/env bash
# dot — interactive dotfiles & package manager for Arch and Ubuntu.
# Run `dot help` for usage.
set -o pipefail

DOT_ROOT=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
export DOT_ROOT

for _f in core os ui managers state links modules github; do
  # shellcheck disable=SC1090
  source "$DOT_ROOT/lib/$_f.sh"
done
unset _f

((BASH_VERSINFO[0] >= 4)) || die "bash >= 4 required"
detect_os
managers_load
export PATH="$HOME/.local/bin:$PATH"

usage() {
  cat <<EOF
${C_BOLD}dot${C_RESET} — manage what gets installed and linked on this machine

${C_BOLD}Usage:${C_RESET} dot [command] [args] [-n|--dry-run] [-y|--yes] [-v|--verbose]

  ${C_CYAN}(no command)${C_RESET}         interactive menu
  ${C_CYAN}status${C_RESET}               what is selected / installed / linked
  ${C_CYAN}list${C_RESET}                 all modules and presets
  ${C_CYAN}plan${C_RESET} [targets]       show exactly what apply would do (nothing is changed)
  ${C_CYAN}apply${C_RESET} [targets]      install + link targets (default: this machine's selection)
  ${C_CYAN}select${C_RESET}               pick modules interactively, then apply / remove the difference
  ${C_CYAN}preset${C_RESET} [name]        start the picker from a preset (e.g. desktop, headless)
  ${C_CYAN}remove${C_RESET} <modules>     unlink configs, deselect, offer to uninstall their packages
  ${C_CYAN}prune${C_RESET}                uninstall packages dot installed that nothing selected needs anymore
  ${C_CYAN}new${C_RESET} [name]           scaffold a new module (asks for packages / configs)
  ${C_CYAN}adopt${C_RESET} <path> [module] move an existing config (e.g. ~/.config/foo) into a module and link it
  ${C_CYAN}edit${C_RESET} [module]        open a module definition in \$EDITOR
  ${C_CYAN}link${C_RESET} / ${C_CYAN}unlink${C_RESET} [modules]  only (un)link configs, no packages
  ${C_CYAN}update${C_RESET}               git pull the dotfiles repo, then apply
  ${C_CYAN}doctor${C_RESET}               check the environment

Targets are module names or @preset (e.g. ${C_DIM}dot plan @desktop${C_RESET}).
Repo: $(pretty "$DOT_ROOT")   OS: $(os_summary)
EOF
}

# ---------------------------------------------------------------- helpers
mod_items() { # "name<TAB>desc" for supported, non-required modules
  local n why
  for n in $(mod_all); do
    mod_load "$n"
    [[ $REQUIRED == 1 ]] && continue
    why=$(mod_supported) || continue
    printf '%s\t%s\n' "$n" "$DESC"
  done
}

targets_or_selection() { # prints targets; falls back to saved selection
  if (($#)); then printf '%s\n' "$@"; else sel_get; fi
}

show_plan() { # show_plan module... ; sets TOTAL_CHANGES
  TOTAL_CHANGES=0
  local n
  for n in "$@"; do
    mod_plan "$n"
    TOTAL_CHANGES=$((TOTAL_CHANGES + PLAN_CHANGES))
  done
  printf '\n%sLegend:%s %s install/link  %s already done  %s backup existing  %s skipped\n' \
    "$C_DIM" "$C_RESET" "$(_sym +)" "$(_sym '=')" "$(_sym '!')" "$(_sym '~')"
}

run_apply() { # run_apply module... (already resolved)
  local n rc
  local -a good=() bad=() skipped=()
  for n in "$@"; do
    mod_apply "$n"; rc=$?
    case $rc in
      0) good+=("$n") ;;
      3) skipped+=("$n") ;;
      *) bad+=("$n") ;;
    esac
  done
  header "Summary"
  ((${#good[@]})) && ok "done:    ${good[*]}"
  ((${#skipped[@]})) && info "skipped: ${skipped[*]}"
  ((${#bad[@]})) && err "failed:  ${bad[*]}"
  [[ -d $BACKUP_DIR ]] && info "backups: $(pretty "$BACKUP_DIR")"
  ((${#bad[@]} == 0))
}

# ---------------------------------------------------------------- commands
cmd_status() {
  header "dot status — $(os_summary)"
  printf '%s%-14s %-4s %-9s %-7s %-9s %s%s\n' "$C_BOLD" MODULE SEL PACKAGES SETUP LINKS STATE "$C_RESET"
  local n s sel pk setup links state color
  for n in $(mod_all); do
    s=$(mod_status "$n")
    if sel_has "$n"; then sel="${C_GREEN}●${C_RESET}"; else sel="${C_DIM}○${C_RESET}"; fi
    if [[ $s == unsupported* ]]; then
      printf '%s%-14s%s %b    %s%s%s\n' "$C_DIM" "$n" "$C_RESET" "$sel" "$C_DIM" "${s#*|}" "$C_RESET"
      continue
    fi
    IFS='|' read -r _ pko pkt setup lo lt lb <<<"$s"
    pk="$pko/$pkt"; ((pkt == 0)) && pk='-'
    links="$lo/$lt"; ((lt == 0)) && links='-'
    ((lb > 0)) && links+='!'
    if [[ $pko == "$pkt" && $setup != no && $lo == "$lt" ]]; then
      state=ready color=$C_GREEN
    elif ((pko == 0 && lo == 0)) && [[ $setup != yes ]]; then
      state=missing color=$C_DIM
    else
      state=partial color=$C_YELLOW
    fi
    case $setup in # multibyte symbols: pad by hand
      yes) setup="${C_GREEN}✓${C_RESET}      " ;;
      no) setup="${C_RED}✗${C_RESET}      " ;;
      *) setup=$(printf '%-7s' "$setup") ;;
    esac
    printf '%-14s %b    %-9s %s %-9s %s%s%s\n' "$n" "$sel" "$pk" "$setup" "$links" "$color" "$state" "$C_RESET"
  done
  printf '\n%s● selected on this machine   links "!" = conflicting file   run "dot plan" for details%s\n' "$C_DIM" "$C_RESET"
}

cmd_list() {
  header "Modules"
  local n why
  for n in $(mod_all); do
    mod_load "$n"
    if why=$(mod_supported); then
      printf '  %-14s %s\n' "$n" "$DESC"
    else
      printf '  %s%-14s %s  [%s]%s\n' "$C_DIM" "$n" "$DESC" "$why" "$C_RESET"
    fi
  done
  header "Presets"
  for n in $(preset_all); do
    printf '  %-14s %s\n' "@$n" "$(preset_desc "$n")"
    printf '  %-14s %s%s%s\n' '' "$C_DIM" "$(preset_modules "$n" | tr '\n' ' ')" "$C_RESET"
  done
}

cmd_plan() {
  local -a t
  mapfile -t t < <(targets_or_selection "$@")
  ((${#t[@]})) || { warn "nothing selected yet — try: dot plan @headless   or   dot select"; return 1; }
  resolve "${t[@]}"
  header "Plan for: ${RESOLVED[*]}"
  show_plan "${RESOLVED[@]}"
  printf '%s%d change(s).%s\n' "$C_BOLD" "$TOTAL_CHANGES" "$C_RESET"
  prune_candidates_preview
}

cmd_apply() {
  local -a t
  mapfile -t t < <(targets_or_selection "$@")
  if ((${#t[@]} == 0)); then
    if ui_interactive; then cmd_select; return; fi
    die "nothing selected — pass modules / @preset, or run 'dot select'"
  fi
  resolve "${t[@]}"
  header "Plan"
  show_plan "${RESOLVED[@]}"
  if ((TOTAL_CHANGES == 0)); then
    ok "Everything is already applied."
    sel_add "${RESOLVED[@]}"
    return 0
  fi
  [[ $DOT_DRY == 1 ]] || ui_confirm "Apply $TOTAL_CHANGES change(s)?" || { info "Cancelled."; return 1; }
  run_apply "${RESOLVED[@]}"
  local rc=$?
  sel_add "${RESOLVED[@]}"
  return $rc
}

# Interactive picker; $1 = preselected names
pick_and_apply() {
  local pre=$1
  ui_interactive || die "select needs a terminal (use: dot apply <modules> --yes)"
  local -a items chosen
  mapfile -t items < <(mod_items)
  mapfile -t chosen < <(ui_choose_many "Modules for this machine:" "$pre" "${items[@]}") || { info "Cancelled."; return 1; }
  local -a current added=() removed=()
  mapfile -t current < <(sel_get)
  local n
  for n in "${chosen[@]}"; do in_list "$n" "${current[@]}" || added+=("$n"); done
  for n in "${current[@]}"; do
    mod_load "$n"; [[ $REQUIRED == 1 ]] && continue
    in_list "$n" "${chosen[@]}" || removed+=("$n")
  done
  resolve "${chosen[@]}"
  header "Plan"
  show_plan "${RESOLVED[@]}"
  if ((${#removed[@]})); then
    printf '\n%sWill remove (unlink + deselect):%s %s\n' "$C_RED" "$C_RESET" "${removed[*]}"
  fi
  if ((TOTAL_CHANGES == 0 && ${#removed[@]} == 0)); then
    ok "Nothing to do."
    sel_write "${RESOLVED[@]}"
    return 0
  fi
  [[ $DOT_DRY == 1 ]] || ui_confirm "Proceed?" || { info "Cancelled."; return 1; }
  local rc=0
  ((${#removed[@]})) && { do_remove "${removed[@]}" || rc=1; }
  run_apply "${RESOLVED[@]}" || rc=1
  sel_write "${RESOLVED[@]}"
  return $rc
}

cmd_select() { pick_and_apply "$(sel_get | tr '\n' ' ')"; }

cmd_preset() {
  local p=${1:-}
  if [[ -z $p ]]; then
    local -a items=()
    local n
    for n in $(preset_all); do items+=("$n"$'\t'"$(preset_desc "$n")"); done
    p=$(ui_choose_one "Choose a preset (you can tweak the modules next):" "${items[@]}") || return 1
  fi
  [[ -f $DOT_ROOT/presets/$p ]] || die "unknown preset: $p (see: dot list)"
  if ! ui_interactive || [[ $DOT_YES == 1 ]]; then
    cmd_apply "@$p"
    return
  fi
  pick_and_apply "$(preset_modules "$p" | tr '\n' ' ') $(sel_get | tr '\n' ' ')"
}

do_remove() { # unlink + teardown + deselect
  local n
  local -a removed=()
  for n in "$@"; do
    mod_exists "$n" || { warn "unknown module: $n"; continue; }
    mod_load "$n"
    [[ $REQUIRED == 1 ]] && { warn "$n is required, not removing"; continue; }
    header "remove $n"
    mod_unlink "$n"
    mod_teardown "$n"
    removed+=("$n")
  done
  ((${#removed[@]})) && sel_del "${removed[@]}"
  return 0
}

cmd_remove() {
  (($#)) || {
    ui_interactive || die "usage: dot remove <module...>"
    local -a items=() picked=()
    local n
    for n in $(sel_get); do mod_load "$n"; [[ $REQUIRED == 1 ]] || items+=("$n"$'\t'"$DESC"); done
    ((${#items[@]})) || { info "Nothing selected."; return 0; }
    mapfile -t picked < <(ui_choose_many "Modules to remove:" "" "${items[@]}")
    ((${#picked[@]})) || return 0
    set -- "${picked[@]}"
  }
  printf 'Will unlink configs and deselect: %s\n' "$*"
  [[ $DOT_DRY == 1 ]] || ui_confirm "Remove $*?" || return 1
  do_remove "$@"
  cmd_prune
}

# packages recorded as installed by dot that no selected module declares
prune_candidates() {
  local -A declared=()
  local n m p
  for n in $(sel_get); do
    mod_exists "$n" || continue
    mod_load "$n"
    for m in "${MGR_ORDER[@]}"; do
      while read -r p; do [[ -n $p ]] && declared["$m $p"]=1; done < <(mod_pkgs "$m")
    done
  done
  local mod
  while read -r mod m p; do
    [[ -z $p ]] && continue
    [[ -n ${declared["$m $p"]:-} ]] && continue
    printf '%s\t%s\n' "$m:$p" "(installed for $mod)"
  done < <(rec_list)
}

prune_candidates_preview() {
  local c; c=$(prune_candidates)
  [[ -z $c ]] && return 0
  printf '\n%sNo longer needed (removable with "dot prune"):%s\n' "$C_YELLOW" "$C_RESET"
  while IFS=$'\t' read -r k rest; do printf '    %s %s %s%s%s\n' "$(_sym -)" "$k" "$C_DIM" "$rest" "$C_RESET"; done <<<"$c"
}

cmd_prune() {
  local -a items chosen
  mapfile -t items < <(prune_candidates)
  ((${#items[@]})) || { ok "Nothing to prune."; return 0; }
  if ui_interactive && [[ $DOT_YES != 1 ]]; then
    mapfile -t chosen < <(ui_choose_many "Uninstall these packages? (only ones dot installed)" "" "${items[@]}")
  else
    mapfile -t chosen < <(printf '%s\n' "${items[@]}" | cut -f1)
  fi
  ((${#chosen[@]})) || { info "Nothing chosen."; return 0; }
  [[ $DOT_DRY == 1 ]] || ui_confirm "Uninstall ${chosen[*]}?" || return 1
  local k m p
  for k in "${chosen[@]}"; do
    m=${k%%:*} p=${k#*:}
    if mgr "$m" m_remove "$p"; then rec_del "$m" "$p"; ok "removed $p ($m)"; else err "failed to remove $p ($m)"; fi
  done
}

cmd_link() {
  local -a t; mapfile -t t < <(targets_or_selection "$@")
  local n src dst
  for n in "${t[@]}"; do
    mod_exists "$n" || { warn "unknown module: $n"; continue; }
    while IFS=$'\t' read -r src dst; do
      [[ -z $src || $(link_state "$src" "$dst") == ok ]] && continue
      link_apply "$src" "$dst" && ok "linked $(pretty "$dst")"
    done < <(links_of "$n")
  done
  [[ -d $BACKUP_DIR ]] && info "backups: $(pretty "$BACKUP_DIR")"
  return 0
}

cmd_unlink() {
  local -a t; mapfile -t t < <(targets_or_selection "$@")
  local n
  for n in "${t[@]}"; do mod_exists "$n" && mod_unlink "$n"; done
}

new_module() { # new_module name desc pkgs pacman apt  -> creates files
  local name=$1 desc=$2 pkgs=$3 pac=$4 apt=$5
  local dir="$DOT_ROOT/modules/$name"
  [[ -e $dir/module.sh ]] && die "module '$name' already exists"
  run mkdir -p "$dir/home" || return 1
  [[ $DOT_DRY == 1 ]] && return 0
  sed -e "s|__NAME__|$name|g" -e "s|__DESC__|${desc//|/ }|g" -e "s|__PKGS__|$pkgs|" \
    -e "s|__PACMAN__|$pac|" -e "s|__APT__|$apt|" "$DOT_ROOT/templates/module.sh" >"$dir/module.sh"
  touch "$dir/home/.gitkeep"
  ok "created $(pretty "$dir/module.sh")"
}

cmd_new() {
  local name=${1:-} desc='' pkgs='' pac='' apt='' configs=''
  if ui_interactive && [[ $DOT_YES != 1 ]]; then
    [[ -n $name ]] || name=$(ui_input "Module name (e.g. starship)")
    [[ -n $name ]] || return 1
    desc=$(ui_input "One-line description")
    pkgs=$(ui_input "Packages with the same name on Arch & Ubuntu (space separated, optional)")
    pac=$(ui_input "Arch-only packages (optional)")
    apt=$(ui_input "Ubuntu-only packages (optional)")
    configs=$(ui_input "Existing configs to adopt, e.g. ~/.config/$name (optional)")
  fi
  [[ -n $name && $name =~ ^[a-zA-Z0-9_-]+$ ]] || die "usage: dot new <name> (letters, digits, - _)"
  new_module "$name" "${desc:-$name}" "$pkgs" "$pac" "$apt" || return 1
  local c
  for c in $configs; do cmd_adopt "${c/#\~/$HOME}" "$name"; done
  if ui_interactive && [[ $DOT_YES != 1 ]]; then
    local presets=() items=() n
    for n in $(preset_all); do items+=("$n"$'\t'"$(preset_desc "$n")"); done
    mapfile -t presets < <(ui_choose_many "Add '$name' to presets? (optional)" "" "${items[@]}")
    for n in "${presets[@]}"; do
      [[ -n $n ]] && echo "$name" >>"$DOT_ROOT/presets/$n" && ok "added to preset $n"
    done
    if ui_confirm "Open module.sh in ${EDITOR:-vi}?"; then "${EDITOR:-vi}" "$DOT_ROOT/modules/$name/module.sh"; fi
  fi
  info "next: dot plan $name   →   dot apply $name"
}

cmd_adopt() {
  local path=${1:-} mod=${2:-}
  [[ -n $path ]] || die "usage: dot adopt <path> [module]"
  path=$(realpath -s "$path")
  [[ $path == "$HOME"/* ]] || die "only paths inside \$HOME can be adopted"
  [[ -e $path || -L $path ]] || die "$(pretty "$path") does not exist"
  local rel=${path#"$HOME"/} unit
  unit=$(link_unit "$rel")
  if [[ $unit != "$rel" ]]; then
    warn "dot links whole entries: will adopt $(pretty "$HOME/$unit") instead of $(pretty "$path")"
    ui_confirm "Continue?" || return 1
  fi
  if [[ -L $HOME/$unit ]]; then
    die "$(pretty "$HOME/$unit") is already a symlink ($(readlink "$HOME/$unit"))"
  fi
  if [[ -z $mod ]]; then
    local -a items=("+new"$'\t'"create a new module")
    local n
    for n in $(mod_all); do mod_load "$n"; items+=("$n"$'\t'"$DESC"); done
    mod=$(ui_choose_one "Adopt $(pretty "$HOME/$unit") into which module?" "${items[@]}") || return 1
    if [[ $mod == +new ]]; then
      mod=$(ui_input "New module name" "$(basename "$unit" | sed 's/^\.//')")
    fi
  fi
  mod_exists "$mod" || new_module "$mod" "$mod" "" "" "" || return 1
  local dest="$DOT_ROOT/modules/$mod/home/$unit"
  [[ -e $dest ]] && die "$(pretty "$dest") already exists in the repo"
  run mkdir -p "$(dirname "$dest")" &&
    run mv "$HOME/$unit" "$dest" &&
    run ln -s "$dest" "$HOME/$unit" || die "adopt failed"
  rm -f "$DOT_ROOT/modules/$mod/home/.gitkeep"
  sel_add "$mod"
  ok "adopted $(pretty "$HOME/$unit") → modules/$mod/home/$unit (now a symlink)"
  info "commit it: git -C $(pretty "$DOT_ROOT") add modules/$mod"
}

cmd_edit() {
  local mod=${1:-}
  if [[ -z $mod ]]; then
    local -a items=() n
    for n in $(mod_all); do mod_load "$n"; items+=("$n"$'\t'"$DESC"); done
    mod=$(ui_choose_one "Edit which module?" "${items[@]}") || return 1
  fi
  mod_exists "$mod" || die "unknown module: $mod"
  "${EDITOR:-vi}" "$DOT_ROOT/modules/$mod/module.sh"
}

cmd_update() {
  header "Updating $(pretty "$DOT_ROOT")"
  run git -C "$DOT_ROOT" pull --ff-only || die "git pull failed (local changes?)"
  # re-exec so the freshly pulled code is used
  local -a flags=()
  [[ $DOT_YES == 1 ]] && flags+=(--yes)
  [[ $DOT_DRY == 1 ]] && flags+=(--dry-run)
  exec "$DOT_ROOT/dot" apply "${flags[@]}"
}

cmd_doctor() {
  header "dot doctor"
  local m
  ok "OS: $(os_summary)  tags: ${OS_TAGS[*]}"
  [[ $OS_FAMILY == unknown ]] && err "unsupported distro family — only Arch and Debian/Ubuntu based distros are handled"
  ok "bash ${BASH_VERSION}"
  ok "repo: $(pretty "$DOT_ROOT")"
  if [[ -n $(git -C "$DOT_ROOT" status --porcelain 2>/dev/null) ]]; then
    warn "repo has uncommitted changes (git -C $(pretty "$DOT_ROOT") status)"
  fi
  if has sudo || [[ $EUID -eq 0 ]]; then ok "sudo available"; else err "sudo not found"; fi
  if has gum; then ok "gum $(gum --version 2>/dev/null | awk '{print $3}')"; else warn "gum missing — plain prompts are used (dot apply core)"; fi
  [[ ":$PATH:" == *":$HOME/.local/bin:"* ]] && ok "~/.local/bin in PATH"
  has dot || warn "'dot' is not on PATH — link it: ln -s $(pretty "$DOT_ROOT/dot") ~/.local/bin/dot"
  for m in "${MGR_ORDER[@]}"; do
    mgr_relevant "$m" || continue
    if mgr "$m" m_available; then ok "manager $m: ${MGR_DESC[$m]}"; else info "manager $m: not available here"; fi
  done
  local broken
  broken=$(find "$HOME" -maxdepth 3 -xtype l -lname "$DOT_ROOT/*" 2>/dev/null)
  if [[ -n $broken ]]; then
    warn "broken links into the repo (module file removed?):"
    sed 's/^/    /' <<<"$broken"
  else
    ok "no broken links into the repo"
  fi
  info "selected: $(sel_get | tr '\n' ' ')"
}

cmd_menu() {
  ui_interactive || { usage; return; }
  [[ -z $(sel_get) ]] && info "Nothing selected on this machine yet — start with 'Use a preset'."
  local choice
  while true; do
    choice=$(ui_choose_one "dot — $(os_summary)" \
      "status"$'\t'"What is selected / installed / linked" \
      "preset"$'\t'"Start from a preset (desktop / headless / ...)" \
      "select"$'\t'"Choose modules for this machine" \
      "apply"$'\t'"Apply the saved selection" \
      "plan"$'\t'"Dry run: show what apply would do" \
      "remove"$'\t'"Remove modules" \
      "new"$'\t'"Create a new module" \
      "adopt"$'\t'"Move an existing config into a module" \
      "prune"$'\t'"Uninstall packages no longer needed" \
      "update"$'\t'"git pull + apply" \
      "doctor"$'\t'"Check the environment" \
      "quit"$'\t'"") || break
    case $choice in
      quit | '') break ;;
      adopt)
        local p; p=$(ui_input "Path to adopt (e.g. ~/.config/foo)")
        [[ -n $p ]] && cmd_adopt "${p/#\~/$HOME}"
        ;;
      *) "cmd_$choice" ;;
    esac
    printf '\n'
    ui_confirm "Back to menu?" || break
  done
}

# ---------------------------------------------------------------- main
main() {
  local -a args=()
  while (($#)); do
    case $1 in
      -n | --dry-run | --dry) DOT_DRY=1 ;;
      -y | --yes) DOT_YES=1 ;;
      -v | --verbose) DOT_VERBOSE=1 ;;
      -h | --help) usage; return 0 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- "${args[@]}"
  local cmd=${1:-menu}
  (($#)) && shift
  case $cmd in
    menu) cmd_menu ;;
    status | st) cmd_status ;;
    list | ls) cmd_list ;;
    plan | diff) cmd_plan "$@" ;;
    apply | install) cmd_apply "$@" ;;
    select) cmd_select ;;
    preset) cmd_preset "$@" ;;
    remove | rm) cmd_remove "$@" ;;
    prune) cmd_prune ;;
    new) cmd_new "$@" ;;
    adopt | add) cmd_adopt "$@" ;;
    edit) cmd_edit "$@" ;;
    link) cmd_link "$@" ;;
    unlink) cmd_unlink "$@" ;;
    update | up) cmd_update ;;
    doctor) cmd_doctor ;;
    bootstrap) DOT_YES=1; cmd_apply core ;; # used by install.sh: core only
    help) usage ;;
    *) err "unknown command: $cmd"; usage; return 1 ;;
  esac
}

main "$@"
