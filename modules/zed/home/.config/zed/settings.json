{
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": false
  },
  "base_keymap": "VSCode",
  "cli_default_open_behavior": "existing_window",
  "theme": "Omazed",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "minimap": {
    "show": "always"
  },
  "format_on_save": "on",
  "agent": {
    "default_model": {
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": true,
      "effort": "low"
    },
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    }
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
      "default_config_options": {
        "mode": "auto"
      }
    },
    "cursor": {
      "type": "registry"
    }
  }
}
